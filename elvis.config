[{elvis, [
    {config, [
        #{ dirs => ["src/**"]
         , filter => "*.erl"
         , ruleset => erl_files
         % these are not enforced by default, so are added here for completeness
         , rules => [{elvis_style, max_module_length, #{}}
                   , {elvis_style, no_common_caveats_call, #{}}
                   , {elvis_style, atom_naming_convention, #{ regex => "^[a-z]+_?([a-z0-9]*_?)*$" }}
                   , {elvis_style, function_naming_convention, #{ regex => "^[a-z]+_?([a-z0-9]*_?)*$" }}
                    ]
         }
      , #{ dirs => ["test/**"]
         , filter => "*.erl"
         , ruleset => erl_files
         % not enforced by default, so added here for completeness; the naming
         % rules relax the erl_files defaults, which reject case names that
         % embed a year (e.g. foo_2024_bar_case/0)
         , rules => [{elvis_style, max_module_length, #{}}
                   , {elvis_style, no_common_caveats_call, #{}}
                   , {elvis_style, atom_naming_convention, #{ regex => "^[a-z]+_?([a-z0-9]*_?)*$" }}
                   , {elvis_style, function_naming_convention, #{ regex => "^[a-z]+_?([a-z0-9]*_?)*$" }}
                    ]
         }
      , #{ dirs => ["."]
         , filter => "rebar.config"
         , ruleset => rebar_config
         , rules => [] }
      , #{ dirs => ["."]
         , filter => "elvis.config"
         , ruleset => elvis_config
         , rules => [] }
    ]}
  , {verbose, true}
]}].
